#!name = B1sTeam — LocketGold (MITM & Header Rewrite)
#!desc = Phần đi kèm của plugin Surge B1sTeam_LocketGold.plugin — gỡ header cache (ETag/If-None-Match) cho RevenueCat, Firebase RC, Locket Camera API + chặn host realtime RC. B1sTeam — b1s.id.vn
#!author = B1sTeam · Nguyễn Hoàng Bách
#!homepage = https://b1s.id.vn/locketvip

# B1sTeam — file include cho Surge plugin (được B1sTeam_LocketGold.plugin #!include).
# Gỡ ETag/cache ⇒ server KHÔNG trả 304 (body rỗng ⇒ app mất entitlement).

[Header Rewrite]
^https?:\/\/(api\.revenuecat\.com|[^/]*\.rc-backup\.com|rev\.cat)\/.+ header-del x-revenuecat-etag
^https?:\/\/(api\.revenuecat\.com|[^/]*\.rc-backup\.com|rev\.cat)\/.+ header-del if-none-match
^https?:\/\/(api\.revenuecat\.com|[^/]*\.rc-backup\.com|rev\.cat)\/.+ header-del if-modified-since
^https?:\/\/([^/]*\.)?(firebaseremoteconfig\.googleapis\.com|firebaseremoteconfig\.google\.com|remoteconfig\.googleapis\.com)\/.+ header-del x-firebase-etag
^https?:\/\/([^/]*\.)?(firebaseremoteconfig\.googleapis\.com|firebaseremoteconfig\.google\.com|remoteconfig\.googleapis\.com)\/.+ header-del x-goog-if-none-match
^https?:\/\/([^/]*\.)?(firebaseremoteconfig\.googleapis\.com|firebaseremoteconfig\.google\.com|remoteconfig\.googleapis\.com)\/.+ header-del if-none-match
^https?:\/\/([^/]*\.)?(firebaseremoteconfig\.googleapis\.com|firebaseremoteconfig\.google\.com|remoteconfig\.googleapis\.com)\/.+ header-del if-modified-since
^https?:\/\/((?:[a-z0-9-]+\.)*(?:locketcamera\.com|locket\.camera)|us-central1-locket-4252a\.cloudfunctions\.net)\/.+ header-del if-none-match
^https?:\/\/((?:[a-z0-9-]+\.)*(?:locketcamera\.com|locket\.camera)|us-central1-locket-4252a\.cloudfunctions\.net)\/.+ header-del if-modified-since

[Host]
firebaseremoteconfigrealtime.googleapis.com = 0.0.0.0
