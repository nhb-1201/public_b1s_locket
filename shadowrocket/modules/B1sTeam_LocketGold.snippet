# B1sTeam — LocketGold (Free) — Snippet cho Stash / Loon
# author: B1sTeam | b1s.id.vn | @b1steam | github.com/nhb-1201/public_b1s_locket
#
# Cùng bộ script với module Shadowrocket (js/*.js) — chỉ khác định dạng file.
# ⚠ Thứ tự trong [Script] có ý nghĩa: Stash/Loon chạy script khớp ĐẦU TIÊN cho mỗi phase.
#
# Cài: Stash/Loon → Subscription/Profile → Snippet → dán link này (hoặc import file).

#!name = B1sTeam — LocketGold (Free)
#!desc = LocketGold trọn đời 0₫ (MITM on-device): RevenueCat Gold vĩnh viễn, Firebase RC bật cờ VIP, gỡ blur + mở paywall, khung Kawaii qua worker B1sTeam, photobooth/overlay, badge Gold. B1sTeam — b1s.id.vn
#!author = B1sTeam · Nguyễn Hoàng Bách
#!homepage = https://b1s.id.vn/locketvip
#!updateInterval = 43200

[General]
bypass-system = true
skip-proxy = *.local,*.crashlytics.com,captive.apple.com
dns-server = doh://doh.b1s.id.vn/fly/dns-query,system
ipv6 = false

[Rule]
DOMAIN-SUFFIX,doh.b1s.id.vn,DIRECT
DOMAIN-SUFFIX,b1s.id.vn,DIRECT
DOMAIN-SUFFIX,locket.b1s.id.vn,DIRECT
DOMAIN-SUFFIX,firebaselogging.googleapis.com,REJECT
DOMAIN-SUFFIX,admob.com,REJECT
DOMAIN-SUFFIX,googlesyndication.com,REJECT
DOMAIN-SUFFIX,doubleclick.net,REJECT
DOMAIN-SUFFIX,googleadservices.com,REJECT
DOMAIN-SUFFIX,appsflyer.com,REJECT
DOMAIN-SUFFIX,appsflyersdk.com,REJECT
DOMAIN-SUFFIX,adjust.com,REJECT
DOMAIN-SUFFIX,criteo.com,REJECT
DOMAIN-SUFFIX,sentry.io,REJECT
DOMAIN-SUFFIX,ingest.sentry.io,REJECT
DOMAIN-SUFFIX,amplitude.com,REJECT
DOMAIN-SUFFIX,mixpanel.com,REJECT
DOMAIN-SUFFIX,moloco.com,REJECT
DOMAIN-SUFFIX,app-ads-services.com,REJECT
DOMAIN-SUFFIX,app-analytics-services.com,REJECT
DOMAIN-SUFFIX,app-measurement.com,REJECT
DOMAIN-SUFFIX,adservice.google.com,REJECT
DOMAIN-SUFFIX,ads.google.com,REJECT
DOMAIN-SUFFIX,analytics.google.com,REJECT
DOMAIN-SUFFIX,amp-api-edge.apps.apple.com,REJECT
AND,((DOMAIN-SUFFIX,firebaseremoteconfig.googleapis.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,firebaseremoteconfig.google.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,remoteconfig.googleapis.com),(PROTOCOL,UDP)),REJECT
DOMAIN,firebaseremoteconfigrealtime.googleapis.com,REJECT
DOMAIN-SUFFIX,revenuecat.com,DIRECT
DOMAIN-SUFFIX,rc-backup.com,DIRECT
DOMAIN-SUFFIX,rev.cat,DIRECT
DOMAIN-SUFFIX,firebaseremoteconfig.googleapis.com,DIRECT
DOMAIN-SUFFIX,firebaseremoteconfig.google.com,DIRECT
DOMAIN-SUFFIX,remoteconfig.googleapis.com,DIRECT
DOMAIN-SUFFIX,locketcamera.com,DIRECT
DOMAIN-SUFFIX,locket.camera,DIRECT
DOMAIN-SUFFIX,cloudfunctions.net,DIRECT
DOMAIN-SUFFIX,firebasestorage.googleapis.com,DIRECT
DOMAIN-SUFFIX,storage.googleapis.com,DIRECT
DOMAIN-SUFFIX,b1steam-frames-1.nhb-120111.workers.dev,DIRECT
DOMAIN-SUFFIX,b1steam-frames-2.nhb-120111.workers.dev,DIRECT
DOMAIN-SUFFIX,b1steam-frames-3.nhb-120111.workers.dev,DIRECT
DOMAIN-SUFFIX,b1steam-frames-4.nhb-120111.workers.dev,DIRECT
DOMAIN-SUFFIX,b1steam-frames-5.nhb-120111.workers.dev,DIRECT
DOMAIN-SUFFIX,b1steam-frames-6.nhb-120111.workers.dev,DIRECT

[Script]
b1s_upload_frame = type=http-request,pattern=^https?:\/\/(firebasestorage\.googleapis\.com|storage\.googleapis\.com)\/.*,script-path=https://raw.githubusercontent.com/nhb-1201/public_b1s_locket/main/shadowrocket/js/b1s_upload_frame.js,requires-body=true,timeout=30,argument=__LICENSE_KEY__
b1s_photobooth_request = type=http-request,pattern=^https?:\/\/((?:[a-z0-9-]+\.)*(?:locketcamera\.com|locket\.camera)|us-central1-locket-4252a\.cloudfunctions\.net)\/.*generateFilteredImage.*,script-path=https://raw.githubusercontent.com/nhb-1201/public_b1s_locket/main/shadowrocket/js/b1s_photobooth_request.js,requires-body=true,timeout=30,argument=__LICENSE_KEY__
b1s_photobooth_response = type=http-response,pattern=^https?:\/\/((?:[a-z0-9-]+\.)*(?:locketcamera\.com|locket\.camera)|us-central1-locket-4252a\.cloudfunctions\.net)\/.*generateFilteredImage.*,script-path=https://raw.githubusercontent.com/nhb-1201/public_b1s_locket/main/shadowrocket/js/b1s_photobooth_response.js,requires-body=true,max-size=-1,timeout=30,argument=__LICENSE_KEY__
b1s_profile_request = type=http-request,pattern=^https?:\/\/((?:[a-z0-9-]+\.)*(?:locketcamera\.com|locket\.camera)|us-central1-locket-4252a\.cloudfunctions\.net)\/.*(changeProfileInfo|\/profile|\/users\/).*,script-path=https://raw.githubusercontent.com/nhb-1201/public_b1s_locket/main/shadowrocket/js/b1s_profile_request.js,requires-body=true,timeout=30,argument=__LICENSE_KEY__
b1s_profile_response = type=http-response,pattern=^https?:\/\/((?:[a-z0-9-]+\.)*(?:locketcamera\.com|locket\.camera)|us-central1-locket-4252a\.cloudfunctions\.net)\/.*(changeProfileInfo|\/profile|\/users\/).*,script-path=https://raw.githubusercontent.com/nhb-1201/public_b1s_locket/main/shadowrocket/js/b1s_profile_response.js,requires-body=true,max-size=-1,timeout=30,argument=__LICENSE_KEY__
b1s_frame_router = type=http-response,pattern=^https?:\/\/((?:[a-z0-9-]+\.)*(?:locketcamera\.com|locket\.camera)|us-central1-locket-4252a\.cloudfunctions\.net)\/.*frame.*,script-path=https://raw.githubusercontent.com/nhb-1201/public_b1s_locket/main/shadowrocket/js/b1s_frame_router.js,requires-body=true,max-size=-1,timeout=30,argument=__LICENSE_KEY__
b1s_locket_api_response = type=http-response,pattern=^https?:\/\/((?:[a-z0-9-]+\.)*(?:locketcamera\.com|locket\.camera)|us-central1-locket-4252a\.cloudfunctions\.net)\/.*,script-path=https://raw.githubusercontent.com/nhb-1201/public_b1s_locket/main/shadowrocket/js/b1s_locket_api_response.js,requires-body=true,max-size=-1,timeout=30,argument=__LICENSE_KEY__
b1s_revenuecat_request = type=http-request,pattern=^https?:\/\/(api\.revenuecat\.com|[^/]*\.rc-backup\.com|rev\.cat)\/.*,script-path=https://raw.githubusercontent.com/nhb-1201/public_b1s_locket/main/shadowrocket/js/b1s_revenuecat_request.js,timeout=30,argument=__LICENSE_KEY__
b1s_revenuecat_response = type=http-response,pattern=^https?:\/\/(api\.revenuecat\.com|[^/]*\.rc-backup\.com|rev\.cat)\/.*,script-path=https://raw.githubusercontent.com/nhb-1201/public_b1s_locket/main/shadowrocket/js/b1s_revenuecat_response.js,requires-body=true,max-size=-1,timeout=30,argument=__LICENSE_KEY__
b1s_firebase_request = type=http-request,pattern=^https?:\/\/([^/]*\.)?(firebaseremoteconfig\.googleapis\.com|firebaseremoteconfig\.google\.com|remoteconfig\.googleapis\.com)\/.*,script-path=https://raw.githubusercontent.com/nhb-1201/public_b1s_locket/main/shadowrocket/js/b1s_firebase_request.js,timeout=30,argument=__LICENSE_KEY__
b1s_firebase_response = type=http-response,pattern=^https?:\/\/([^/]*\.)?(firebaseremoteconfig\.googleapis\.com|firebaseremoteconfig\.google\.com|remoteconfig\.googleapis\.com)\/.*,script-path=https://raw.githubusercontent.com/nhb-1201/public_b1s_locket/main/shadowrocket/js/b1s_firebase_response.js,requires-body=true,max-size=-1,timeout=30,argument=__LICENSE_KEY__
b1s_conf_header = type=http-request,pattern=^https?:\/\/((?:[a-z0-9-]+\.)*(?:locketcamera\.com|locket\.camera)|us-central1-locket-4252a\.cloudfunctions\.net)\/.*,script-path=https://raw.githubusercontent.com/nhb-1201/public_b1s_locket/main/shadowrocket/js/b1s_conf_header.js,timeout=20,argument=__LICENSE_KEY__

[MITM]
hostname = api.revenuecat.com, *.rc-backup.com, rev.cat, *.firebaseremoteconfig.googleapis.com, *.firebaseremoteconfig.google.com, *.remoteconfig.googleapis.com, *.locketcamera.com, locket.camera, us-central1-locket-4252a.cloudfunctions.net, *.firebasestorage.googleapis.com, storage.googleapis.com
