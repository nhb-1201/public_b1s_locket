# author: B1sTeam | b1s.id.vn | @b1steam | github.com/nhb-1201/public_b1s_locket
# Locket Gold — Android .htaccess · B1sTeam v3.0
# Phục vụ file cấu hình công khai: CORS cho V2RayNG/Sing-Box, MIME types chính xác.

# ─── CORS + Headers bảo mật ───────────────────────────────
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type"
    Header set X-Content-Type-Options "nosniff"
    Header set Cache-Control "public, max-age=300"
    <FilesMatch "\.(json|dns)$">
        Header set Cache-Control "public, max-age=60"
    </FilesMatch>
</IfModule>

# ─── Chặn method không an toàn ───────────────────────────
<LimitExcept GET OPTIONS HEAD>
    Require all denied
</LimitExcept>

# ─── MIME types ───────────────────────────────────────────
AddType application/json .json
AddType text/plain       .dns
AddType image/svg+xml    .svg
AddCharset utf-8 .json .dns .svg

# ─── Giữ rule tường minh chống hotlink tùy tiện ─────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(v2rayng|singbox)\.json$ - [L]
    RewriteRule ^locketgold\.dns$ - [L]
</IfModule>

# ─── Chặn liệt kê thư mục ────────────────────────────────
Options -Indexes
