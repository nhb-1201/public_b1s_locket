{
  "version": 2,
  "cleanUrls": false,
  "rewrites": [
    { "source": "/api/profile", "destination": "/api/generate-profile" },
    { "source": "/api/locketgold-profile.mobileconfig", "destination": "/api/generate-profile" }
  ],
  "headers": [
    {
      "source": "/api/generate-profile",
      "headers": [
        { "key": "Content-Type", "value": "application/x-apple-aspen-config" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"B1sTeam-LocketGold.mobileconfig\"" }
      ]
    },
    {
      "source": "/(.*)\\.mobileconfig",
      "headers": [
        { "key": "Content-Type", "value": "application/x-apple-aspen-config" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
