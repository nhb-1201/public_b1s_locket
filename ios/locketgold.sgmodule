{
  "version": 2,
  "rule_providers": {},
  "direct": "DIRECT",
  "proxy": "DIRECT",
  "reject": "REJECT",
  "rules": [
    "IP-CIDR,127.0.0.0/8,DIRECT",
    "IP-CIDR,10.0.0.0/8,DIRECT",
    "IP-CIDR,172.16.0.0/12,DIRECT",
    "IP-CIDR,192.168.0.0/16,DIRECT",
    "FINAL,DIRECT"
  ],
  "script": [
    {
      "type": "http-response",
      "pattern": "^https://api.(revenuecat|rc-backup).com/.+/(receipts$|subscribers/[^/?]+(\\?.*)?$)",
      "script-path": "https://raw.githubusercontent.com/nhb-1201/public_b1s_locket/main/ios/scripts/locketgold_revenuecat.js",
      "requires-body": true,
      "max-size": -1,
      "timeout": 30,
      "argument": {}
    },
    {
      "type": "http-request",
      "pattern": "^https://api.(revenuecat|rc-backup).com/.+/(receipts|subscribers)",
      "script-path": "https://raw.githubusercontent.com/nhb-1201/public_b1s_locket/main/ios/scripts/locketgold_deleteHeader.js",
      "timeout": 30
    },
    {
      "type": "http-response",
      "pattern": "^https://firebaseremoteconfig.googleapis.com/v1/projects/locket-4252a/.+",
      "script-path": "https://raw.githubusercontent.com/nhb-1201/public_b1s_locket/main/ios/scripts/locketgold_remote.js",
      "requires-body": true,
      "max-size": -1,
      "timeout": 30,
      "argument": {}
    },
    {
      "type": "http-request",
      "pattern": "^https://api.locketcamera.com/changeProfileInfo",
      "script-path": "https://raw.githubusercontent.com/nhb-1201/public_b1s_locket/main/ios/scripts/locketgold_profile.js",
      "timeout": 30,
      "argument": "request"
    },
    {
      "type": "http-response",
      "pattern": "^https://api.locketcamera.com/.+",
      "script-path": "https://raw.githubusercontent.com/nhb-1201/public_b1s_locket/main/ios/scripts/locketgold_profile.js",
      "requires-body": true,
      "max-size": -1,
      "timeout": 30,
      "argument": "response"
    }
  ],
  "mitm": [
    "api.revenuecat.com",
    "api.rc-backup.com",
    "firebaseremoteconfig.googleapis.com",
    "api.locketcamera.com"
  ],
  "name": "Locket Gold VIP — B1sTeam v3.0",
  "desc": "Module Shadowrocket mở khóa Locket Gold VIP vĩnh viễn (Gold Badge, Icon, Themes, Views, 0 quảng cáo). B1sTeam — b1s.id.vn · @b1steam",
  "author": "B1sTeam",
  "homepage": "https://b1s.id.vn/locketgold"
}