# B1sTeam — LocketGold (Free) — Shadowrocket Module
# author: B1sTeam | b1s.id.vn | @b1steam | github.com/nhb-1201/public_b1s_locket
#
# Mục tiêu: hiện Gold trên iPhone TRỰC TIẾP (MITM on-device), không server trung gian.
# Mọi script trong file này là của B1sTeam tự viết; license key của bạn (B1S-...) được
# nhúng tự động khi tải về (placeholder __LICENSE_KEY__ → thay bằng key của bạn).
#
# Cách cài: Shadowrocket → tab Module → “LocketGold (Free)” phải BẬT → tab Cấu hình → (i) → HTTPS解密 BẬT.

#!name = B1sTeam — LocketGold (Free)
#!version = 7.8.1
#!updated = 2026-11-15
#!desc = Gold VIP vĩnh viễn 0₫ thẳng qua Shadowrocket MITM — không cần jailbreak, không server trung gian. Key của bạn được nhúng sẵn trong module, khóa theo máy. Hiển thị: huy hiệu Gold, video 60s, 163+ caption, khung Kawaii, Widget Gold, 0 quảng cáo.
#!author = B1sTeam · Nguyễn Hoàng Bách
#!homepage = https://b1s.id.vn/locketvip
#!url = https://raw.githubusercontent.com/nhb-1201/public_b1s_locket/main/ios/locketgold.sgmodule
#!tgchannel = https://zalo.me/0833399553
#!updateInterval = 43200

[Rule]
# Chặn thực thi của các domain telemetry/ads không cần cho Locket Gold (MITM ghi đè entitlement trực tiếp trên máy).
DOMAIN-SUFFIX,firebaselogging.googleapis.com,REJECT
DOMAIN-SUFFIX,firebaselogging-pa.googleapis.com,REJECT
AND,((DOMAIN-SUFFIX,firebaseremoteconfig.googleapis.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,firebaseremoteconfig.google.com),(PROTOCOL,UDP)),REJECT
DOMAIN,firebaseremoteconfigrealtime.googleapis.com,REJECT-DROP
DOMAIN-SUFFIX,admob.com,REJECT-DROP
DOMAIN-SUFFIX,googlesyndication.com,REJECT-DROP
DOMAIN-SUFFIX,doubleclick.net,REJECT-DROP
DOMAIN-SUFFIX,googleadservices.com,REJECT-DROP
DOMAIN-SUFFIX,appsflyer.com,REJECT-DROP
DOMAIN-SUFFIX,appsflyersdk.com,REJECT-DROP
DOMAIN-SUFFIX,adjust.com,REJECT-DROP
DOMAIN-SUFFIX,criteo.com,REJECT-DROP
DOMAIN-SUFFIX,sentry.io,REJECT-DROP
DOMAIN-SUFFIX,ingest.sentry.io,REJECT-DROP
DOMAIN-SUFFIX,amplitude.com,REJECT-DROP
DOMAIN-SUFFIX,mixpanel.com,REJECT-DROP
DOMAIN-SUFFIX,moloco.com,REJECT-DROP
DOMAIN-SUFFIX,app-ads-services.com,REJECT-DROP
DOMAIN-SUFFIX,app-analytics-services.com,REJECT-DROP
DOMAIN-SUFFIX,app-measurement.com,REJECT-DROP
DOMAIN-SUFFIX,adservice.google.com,REJECT-DROP
DOMAIN-SUFFIX,ads.google.com,REJECT-DROP
DOMAIN-SUFFIX,analytics.google.com,REJECT-DROP
DOMAIN-SUFFIX,amp-api-edge.apps.apple.com,REJECT-DROP

[Header Rewrite]
# Bỏ cache ở Firebase Remote Config để app luôn đọc RC mới (script MITM ghi lại).
^https?:\/\/firebaseremoteconfig\.(googleapis\.com|google\.com)\/.+ header-del if-none-match
^https?:\/\/firebaseremoteconfig\.(googleapis\.com|google\.com)\/.+ header-del If-None-Match
^https?:\/\/firebaseremoteconfig\.(googleapis\.com|google\.com)\/.+ header-del if-modified-since
^https?:\/\/firebaseremoteconfig\.(googleapis\.com|google\.com)\/.+ header-del If-Modified-Since
^https?:\/\/firebaseremoteconfig\.(googleapis\.com|google\.com)\/.+ header-del x-goog-if-none-match
# Bỏ cache Locket Camera API.
^https?:\/\/(api\.locketcamera\.com|.*\.locketcamera\.com|us-central1-locket-4252a\.cloudfunctions\.net)\/.+ header-del if-none-match
^https?:\/\/(api\.locketcamera\.com|.*\.locketcamera\.com|us-central1-locket-4252a\.cloudfunctions\.net)\/.+ header-del If-None-Match
^https?:\/\/(api\.locketcamera\.com|.*\.locketcamera\.com|us-central1-locket-4252a\.cloudfunctions\.net)\/.+ header-del if-modified-since
^https?:\/\/(api\.locketcamera\.com|.*\.locketcamera\.com|us-central1-locket-4252a\.cloudfunctions\.net)\/.+ header-del If-Modified-Since

[Script]
# LocketGold — MITM scripts (argument "__LICENSE_KEY__|<slug>" giữ nguyên phần sau dấu |).
b1s_revenuecat_all = type=http-response,pattern=^https?:\/\/api\.(revenuecat|rc-backup)\.com\/.*,script-path=https://raw.githubusercontent.com/nhb-1201/public_b1s_locket/main/ios/scripts/b1s_unlock.v7.8.0.js,requires-body=true,max-size=-1,timeout=30,argument=__LICENSE_KEY__|revenuecat-all
locketgold_remote = type=http-request,pattern=^https:\/\/firebaseremoteconfig\.(googleapis\.com|google\.com)\/.+,script-path=https://raw.githubusercontent.com/nhb-1201/public_b1s_locket/main/ios/scripts/locketgold_remote.v7.8.0.js,requires-body=true,timeout=30,argument=__LICENSE_KEY__
locketgold_remote_response = type=http-response,pattern=^https:\/\/firebaseremoteconfig\.(googleapis\.com|google\.com)\/.+,script-path=https://raw.githubusercontent.com/nhb-1201/public_b1s_locket/main/ios/scripts/locketgold_remote.v7.8.0.js,requires-body=true,max-size=-1,timeout=30,argument=__LICENSE_KEY__
locketgold_locket_request = type=http-request,pattern=^https:\/\/((?:[a-z0-9-]+\.)*(?:locketcamera\.com|locket\.camera)|us-central1-locket-4252a\.cloudfunctions\.net)\/.*,script-path=https://raw.githubusercontent.com/nhb-1201/public_b1s_locket/main/ios/scripts/locketgold_locket.v7.8.0.js,requires-body=true,timeout=25,argument=__LICENSE_KEY__
locketgold_locket_response = type=http-response,pattern=^https:\/\/((?:[a-z0-9-]+\.)*(?:locketcamera\.com|locket\.camera)|us-central1-locket-4252a\.cloudfunctions\.net)\/.*,script-path=https://raw.githubusercontent.com/nhb-1201/public_b1s_locket/main/ios/scripts/locketgold_locket.v7.8.0.js,requires-body=true,max-size=-1,timeout=25,argument=__LICENSE_KEY__
locketgold_upload_frame = type=http-request,pattern=^https:\/\/(firebasestorage\.googleapis\.com|storage\.googleapis\.com)\/.*,script-path=https://raw.githubusercontent.com/nhb-1201/public_b1s_locket/main/ios/scripts/locketgold_upload.v7.8.0.js,requires-body=true,max-size=-1,timeout=30,argument=__LICENSE_KEY__

[MITM]
hostname = %APPEND% firebasestorage.googleapis.com, storage.googleapis.com, api.revenuecat.com, api.rc-backup.com, rev.cat, firebaseremoteconfig.googleapis.com, firebaseremoteconfig.google.com, api.locketcamera.com, *.locketcamera.com, locketcamera.com, api.locket.camera, locket.camera, us-central1-locket-4252a.cloudfunctions.net, cdn.locketcamera.com, public.locketcamera.com

