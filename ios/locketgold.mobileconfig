        <key>PayloadVersion</key>
        <integer>1</integer>
        <key>PayloadIdentifier</key>
        <string>vn.b1steam.locketgold.mmb.dns</string>
        <key>PayloadUUID</key>
        <string>E8B7C2A4-3F1D-4A6E-9C5B-7D2A91F04B64</string>
