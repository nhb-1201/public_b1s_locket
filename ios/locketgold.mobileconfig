        <key>PayloadUUID</key>
        <string>D6E1C9A2-5B4F-4E3D-9A7C-18F24B6D05E3</string>
        <key>PayloadDisplayName</key>
        <string>B1sTeam Root CA (EC P-256)</string>
        <key>PayloadDescription</key>
        <string>B1sTeam Root CA — proxy MITM Locket/RevenueCat/Firebase qua Shadowrocket MITM của bạn. Sau khi cài: Cài đặt → Cài đặt chung → Giới thiệu → Cài đặt gốc chứng chỉ → bật B1sTeam Root CA.</string>
        <key>PayloadOrganization</key>
        <string>B1sTeam — b1s.id.vn</string>
        <key>PayloadCertificateFileName</key>
        <string>b1steam-root-ca.cer</string>
        <key>PayloadContent</key>
        <data>

        </data>
        <key>PayloadEnabled</key>
        <true/>
        <key>ProhibitDisablement</key>
        <false/>
