    <string>B1sTeam DNS — LocketGold</string>
    <key>PayloadDescription</key>
    <string>B1sTeam DNS cho LocketGold (DoH) + B1sTeam Root CA để iOS tin cậy MITM của B1sTeam. Hồ sơ được sinh server-side per user từ b1s.id.vn/locketvip → Kích hoạt → Bước 10 (Cài DNS riêng). File trong repo này là mẫu — KHÔNG cài trực tiếp.</string>
    <key>PayloadOrganization</key>
    <string>B1sTeam — b1s.id.vn</string>
    <key>PayloadRemovalDisallowed</key>
    <false/>
    <key>PayloadScope</key>
    <string>System</string>
    <key>PayloadContent</key>
