# author: B1sTeam | b1s.id.vn | @b1steam | github.com/nhb-1201/public_b1s_locket
# Locket Gold — iOS .htaccess · B1sTeam v3.0
# Phục vụ file cấu hình công khai: CORS cho Shadowrocket, MIME types chính xác, cache có kiểm soát.

# ─── CORS + Headers bảo mật ───────────────────────────────
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type"
    Header set X-Content-Type-Options "nosniff"
    Header set Cache-Control "public, max-age=300"
    <FilesMatch "\.(mobileconfig|sgmodule|conf|html)$">
        Header set Cache-Control "public, max-age=60"
    </FilesMatch>
</IfModule>

# ─── Chặn method không an toàn ───────────────────────────
<LimitExcept GET OPTIONS HEAD>
    Require all denied
</LimitExcept>

# ─── MIME types ───────────────────────────────────────────
AddType application/x-apple-aspen-config .mobileconfig
AddType application/octet-stream          .sgmodule
AddType text/plain                        .conf
AddType text/html                         .html
AddType image/svg+xml                     .svg
AddCharset utf-8 .conf .html .svg

# ─── Redirect module.html → sgmodule không cần thiết khi có CORS,
#     nhưng giữ rule tường minh để tránh hotlink sang domain lạ ───
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(module|conf)\.html$ - [L]
</IfModule>

# ─── Chặn liệt kê thư mục ────────────────────────────────
Options -Indexes
